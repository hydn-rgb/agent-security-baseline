{
  "_comment": "复制为 config.json 后按你的环境修改。config.json 已被 .gitignore 排除，不会上传。",

  "workbuddy_dir": "~/.workbuddy",
  "sessions_dir": "~/.workbuddy/projects",

  "scan_roots": [
    "~/projects",
    "~/work"
  ],

  "allowed_egress_hosts": [
    "localhost", "127.0.0.1", "::1",
    "github.com", "raw.githubusercontent.com", "api.github.com",
    "pypi.org", "files.pythonhosted.org",
    "registry.npmjs.org", "cdn.jsdelivr.net"
  ],

  "trusted_remote_host_hints": [
    "github.com", "gitee.com", "gitlab", "coding.net", "bitbucket.org"
  ],

  "credential_paths": [
    "~/.ssh",
    "~/.aws",
    "~/.config/gcloud",
    "~/.workbuddy/keyblob",
    "~/.workbuddy/security",
    "~/.netrc",
    "~/.gitconfig"
  ],

  "sensitive_path_patterns": [
    "\\.ssh[/\\\\]",
    "id_(rsa|dsa|ecdsa|ed25519)",
    "keyblob",
    "\\.aws[/\\\\]",
    "\\.config[/\\\\]gcloud",
    "\\.netrc",
    "credentials?\\.json",
    "(token|secret|passwd|password)\\.(txt|json|env|ya?ml)"
  ],

  "combo_window_seconds": 300
}
